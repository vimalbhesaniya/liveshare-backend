{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "next build"
    },
    "realtime": {
      "root": ".",
      "framework": "node",
      "entrypoint": "dist/socket-server.js",
      "buildCommand": "npx esbuild socket-server.ts --bundle --platform=node --format=cjs --outfile=dist/socket-server.js --packages=external"
    }
  },
  "rewrites": [
    {
      "source": "/socket.io",
      "destination": { "service": "realtime" }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": { "service": "realtime" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
